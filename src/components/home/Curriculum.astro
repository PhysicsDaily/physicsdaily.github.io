---
import ArrowIcon from '../ui/ArrowIcon.astro';
import { base, getChapters } from '../../lib/chapters';
import { branches } from '../../site.config';

// Branch list and canonical slugs come from site.config.ts — the chapter count
// is computed automatically from the sidebar, so launching a branch means
// flipping its `live` flag there and creating its content directory.

const sidebar = Astro.locals.starlightRoute.sidebar;

/** Chapters of an active branch, in the reading order the sidebar declares. */
const chapterCount = (slug: string): number => getChapters(sidebar, slug).length;
---

<section class="pd-section not-content" id="curriculum">
	<header class="pd-section__head">
		<p class="pd-eyebrow">Curriculum</p>
		<h2 class="pd-title">The six branches of physics</h2>
		<p class="pd-lede">
			Each branch is divided into chapters meant to be read in order, since later chapters build on
			earlier ones. Mechanics is available now; the remaining branches are in progress.
		</p>
	</header>

	<ol class="pd-track">
		{
			branches.map((branch, index) => {
				const number = String(index + 1).padStart(2, '0');
				const count = branch.live ? chapterCount(branch.slug) : 0;
				const body = (
					<>
						<span class="pd-branch__num">{number}</span>
						<div class="pd-branch__body">
							<h3 class="pd-branch__name">{branch.name}</h3>
						</div>
						<span class="pd-branch__meta">
							{branch.live ? (
								<>
									<span class="pd-branch__dot" />
									{count} {count === 1 ? 'chapter' : 'chapters'}
									<ArrowIcon size={15} />
								</>
							) : (
								'Planned'
							)}
						</span>
					</>
				);

				return (
					<li>
						{branch.live ? (
							<a class="pd-branch" href={`${base}${branch.slug}/`}>
								{body}
							</a>
						) : (
							<div class="pd-branch pd-branch--planned">{body}</div>
						)}
					</li>
				);
			})
		}
	</ol>
</section>
