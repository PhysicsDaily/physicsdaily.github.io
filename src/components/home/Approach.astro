---
import Icon from '../ui/Icon.astro';

// Homepage-only styles are loaded once, through home/Hero.astro, which
// renders on every page that declares a hero — the homepage is the only one.
const features = [
	{
		title: 'Step-by-step derivations',
		description:
			'Every result is derived from stated assumptions, so you can follow each step instead of taking it on trust.',
		icon: 'notes' as const,
	},
	{
		title: 'Clearly typeset equations',
		description:
			'Math is typeset with KaTeX, so it stays sharp, selectable, and readable at any size.',
		icon: 'sigma' as const,
	},
	{
		title: 'Diagrams and video',
		description:
			'Labelled figures for the geometry, plus a video explanation where watching is easier than reading.',
		icon: 'video' as const,
	},
	{
		title: 'Interactive simulations',
		description:
			'Simulations sit next to the theory, so you can change one variable and see how the rest responds.',
		icon: 'sliders' as const,
	},
];
---

<section class="pd-section not-content">
	<header class="pd-section__head">
		<p class="pd-eyebrow">Inside a chapter</p>
		<h2 class="pd-title">What every chapter includes</h2>
	</header>

	<ul class="pd-features">
		{
			features.map((feature) => (
				<li class="pd-feature">
					<Icon name={feature.icon} size={22} strokeWidth={1.5} />
					<h3>{feature.title}</h3>
					<p>{feature.description}</p>
				</li>
			))
		}
	</ul>
</section>
