---
import ArrowIcon from '../ui/ArrowIcon.astro';
import { feedback as feedbackConfig } from '../../site.config';
import { base } from '../../lib/paths';

const feedbackUrl = `${base}feedback/`;
---

<section class="pd-section not-content" id="feedback">
	<div class="pd-cta">
		<div class="pd-cta__copy">
			<p class="pd-eyebrow">{feedbackConfig.homeSectionEyebrow}</p>
			<h2 class="pd-title">{feedbackConfig.homeSectionTitle}</h2>
			<p class="pd-lede">{feedbackConfig.homeSectionLede}</p>
		</div>
		<a href={feedbackUrl} class="pd-btn pd-btn--primary">
			{feedbackConfig.homeButtonText}
			<ArrowIcon />
		</a>
	</div>
</section>
