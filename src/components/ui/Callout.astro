---
import Icon from './Icon.astro';

// Editorial callout for units, definitions, key intuitions, and common traps.
interface Props {
	type?: 'note' | 'tip' | 'warning' | 'definition' | 'units';
	title?: string;
}

const { type = 'note', title } = Astro.props;

const defaultTitles = {
	note: 'Note',
	tip: 'Key Intuition',
	warning: 'Common Pitfall',
	definition: 'Definition',
	units: 'Units and Dimensions',
};

const displayTitle = title ?? defaultTitles[type];
const icon = type === 'units' ? 'definition' : type;
---

<div class={`pd-card pd-callout pd-callout--${type} not-content`}>
	<div class="pd-callout__header">
		<span class="pd-callout__icon" aria-hidden="true">
			<Icon name={icon} />
		</span>
		<strong class="pd-callout__title">{displayTitle}</strong>
	</div>
	<div class="pd-callout__body pd-flow">
		<slot />
	</div>
</div>

<style>
	.pd-callout {
		margin: 1.75rem 0;
		padding: 1.15rem 1.35rem;
		border-left: 3px solid var(--sl-color-accent);
		font-size: 0.96rem;
		line-height: 1.65;
		color: var(--sl-color-gray-1);
	}

	.pd-callout--tip {
		border-left-color: var(--sl-color-accent);
		background: color-mix(in srgb, var(--sl-color-accent) 4%, var(--pd-surface));
	}

	.pd-callout--warning {
		border-left-color: var(--pd-warning);
		background: color-mix(in srgb, var(--pd-warning) 5%, var(--pd-surface));
	}

	.pd-callout--definition,
	.pd-callout--units {
		border-left-color: var(--sl-color-gray-2);
	}

	.pd-callout__header {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		margin-bottom: 0.5rem;
	}

	.pd-callout__icon {
		display: flex;
		align-items: center;
		color: var(--sl-color-accent);
	}

	.pd-callout--warning .pd-callout__icon {
		color: var(--pd-warning);
	}

	.pd-callout--definition .pd-callout__icon,
	.pd-callout--units .pd-callout__icon {
		color: var(--sl-color-gray-2);
	}

	.pd-callout__title {
		font-family: var(--sl-font);
		font-size: 0.85rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--sl-color-white);
	}
</style>
