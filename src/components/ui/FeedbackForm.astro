---
// Feedback form that posts to Google Forms; all copy and field IDs come from site.config.ts.
import ArrowIcon from './ArrowIcon.astro';
import { feedback as feedbackConfig } from '../../site.config';
---

<div class="pd-card pd-feedback-container">
	<pd-feedback-form
		data-success={feedbackConfig.successMessage}
		data-error={feedbackConfig.errorMessage}
		data-fallback-text={feedbackConfig.fallbackLinkText}
		data-fallback-url={feedbackConfig.directFormUrl}
		data-btn-text={feedbackConfig.buttonText}
	>
		<form
			action={feedbackConfig.formActionUrl}
			method="POST"
			class="pd-feedback__form"
		>
			<div class="pd-feedback__field">
				<label for="pd-feedback-message" class="pd-feedback__label">
					Your message, feedback, or appreciation <span class="pd-feedback__req" aria-hidden="true">*</span>
				</label>
				<textarea
					id="pd-feedback-message"
					name={feedbackConfig.messageEntryId}
					rows="6"
					required
					placeholder={feedbackConfig.placeholderMessage}
					class="pd-feedback__textarea"
				></textarea>
			</div>

			<div class="pd-feedback__field">
				<label for="pd-feedback-email" class="pd-feedback__label">
					Email <span class="pd-feedback__req" aria-hidden="true">*</span>
				</label>
				<input
					type="email"
					id="pd-feedback-email"
					name={feedbackConfig.emailEntryId}
					required
					placeholder={feedbackConfig.placeholderEmail}
					class="pd-feedback__input"
					autocomplete="email"
				/>
			</div>

			<div class="pd-feedback__footer">
				<button type="submit" class="pd-btn pd-btn--primary pd-feedback__submit">
					<span class="pd-feedback__submit-text">{feedbackConfig.buttonText}</span>
					<ArrowIcon />
				</button>
			</div>

			<div class="pd-feedback__status" aria-live="polite" hidden></div>
		</form>
	</pd-feedback-form>
</div>

<script>
	class PDFeedbackForm extends HTMLElement {
		connectedCallback() {
			const form = this.querySelector('form');
			const submitBtn = this.querySelector('.pd-feedback__submit') as HTMLButtonElement | null;
			const submitText = this.querySelector('.pd-feedback__submit-text');
			const status = this.querySelector('.pd-feedback__status') as HTMLElement | null;
			if (!form || !submitBtn || !status) return;

			const { success = '', error = '', fallbackText = '', fallbackUrl = '', btnText = '' } = this.dataset;

			const show = (kind: 'success' | 'error', message: string) => {
				status.className = `pd-feedback__status pd-feedback__status--${kind}`;
				const text = document.createElement('strong');
				text.textContent = message;
				status.replaceChildren(text);
				if (kind === 'error' && fallbackUrl) {
					const link = document.createElement('a');
					link.href = fallbackUrl;
					link.textContent = fallbackText;
					link.rel = 'noopener';
					status.append(link);
				}
				status.hidden = false;
			};

			form.addEventListener('submit', async (event) => {
				event.preventDefault();
				submitBtn.disabled = true;
				if (submitText) submitText.textContent = 'Sending...';
				status.hidden = true;

				try {
					// Google Forms sends no CORS headers, so the response is opaque: only a network failure rejects.
					await fetch(form.action, { method: 'POST', mode: 'no-cors', body: new FormData(form) });
					form.reset();
					show('success', success);
				} catch {
					show('error', error);
				} finally {
					submitBtn.disabled = false;
					if (submitText) submitText.textContent = btnText;
				}
			});
		}
	}

	if (!customElements.get('pd-feedback-form')) {
		customElements.define('pd-feedback-form', PDFeedbackForm);
	}
</script>
