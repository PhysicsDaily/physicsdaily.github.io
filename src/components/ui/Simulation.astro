---
// Lazy iframe embed for interactive simulations such as PhET.
interface Props {
	src: string;
	title: string;
	height?: number;
}

const { src, title, height = 620 } = Astro.props;
---

<div class="pd-embed simulation-frame not-content" style={`--simulation-height: ${height}px`}>
	<iframe
		src={src}
		title={title}
		loading="lazy"
		referrerpolicy="strict-origin-when-cross-origin"
		allow="autoplay; clipboard-write; fullscreen"
		allowfullscreen
	></iframe>
</div>

<style>
	.simulation-frame {
		height: var(--simulation-height);
		min-height: 28rem;
		background: var(--sl-color-bg-nav);
		box-shadow: 0 14px 35px rgb(0 0 0 / 10%);
	}

	@media (max-width: 40rem) {
		.simulation-frame {
			height: min(var(--simulation-height), 34rem);
		}
	}
</style>
