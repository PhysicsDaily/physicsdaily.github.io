---
import Icon from './Icon.astro';

// Practice question with a click-to-reveal worked answer.
interface Props {
	question: string;
	buttonText?: string;
}

const { question, buttonText = 'Reveal Explanation' } = Astro.props;
---

<div class="pd-card pd-quick-check not-content">
	<div class="pd-quick-check__header">
		<span class="pd-badge">
			<Icon name="help" size={13} />
			Quick Check
		</span>
		<p class="pd-quick-check__question">{question}</p>
	</div>

	<details class="pd-quick-check__details">
		<summary class="pd-quick-check__summary">
			<span>{buttonText}</span>
			<span class="pd-quick-check__chevron"><Icon name="chevron" size={14} /></span>
		</summary>
		<div class="pd-quick-check__answer pd-flow">
			<slot />
		</div>
	</details>
</div>

<style>
	.pd-quick-check {
		margin: 2rem 0;
		padding: 1.35rem 1.45rem;
	}

	.pd-quick-check__header {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin-bottom: 0.95rem;
	}

	.pd-quick-check__question {
		margin: 0;
		font-size: 1.02rem;
		font-weight: 500;
		line-height: 1.5;
		color: var(--sl-color-white);
	}

	.pd-quick-check__details {
		margin-top: 0.5rem;
	}

	.pd-quick-check__summary {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.45rem 0.85rem;
		font-size: 0.84rem;
		font-weight: 500;
		color: var(--sl-color-gray-2);
		background: var(--pd-surface-hover);
		border: 1px solid var(--pd-rule-strong);
		border-radius: var(--pd-radius);
		cursor: pointer;
		user-select: none;
		list-style: none;
		transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease;
	}

	.pd-quick-check__summary::-webkit-details-marker {
		display: none;
	}

	.pd-quick-check__summary:hover {
		color: var(--sl-color-white);
		border-color: var(--sl-color-accent);
	}

	.pd-quick-check__chevron {
		display: inline-flex;
		transition: transform 200ms ease;
	}

	.pd-quick-check__details[open] .pd-quick-check__chevron {
		transform: rotate(180deg);
	}

	.pd-quick-check__answer {
		margin-top: 0.85rem;
		padding: 1rem 1.15rem;
		background: color-mix(in srgb, var(--sl-color-accent) 4%, var(--pd-surface));
		border-left: 2px solid var(--sl-color-accent);
		border-radius: 0 var(--pd-radius) var(--pd-radius) 0;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}
</style>
