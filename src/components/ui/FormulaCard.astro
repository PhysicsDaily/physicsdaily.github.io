---
import Icon from './Icon.astro';

// Framed equation with a badge, title, and a single-line variable description below the formula.
interface Props {
	title: string;
	label?: 'Key Formula' | 'Definition' | 'Vector Form' | 'Scalar Form' | `Equation ${number}`;
	description?: string;
	note?: string;
}

const { title, label = 'Formula', description, note } = Astro.props;
---

<div class="pd-card pd-formula-card">
	<div class="pd-formula-card__header">
		<span class="pd-badge pd-formula-card__badge">
			<Icon name="formula" size={12} />
			{label}
		</span>
		<h4 class="pd-formula-card__title">{title}</h4>
	</div>

	{description && <p class="pd-formula-card__desc">{description}</p>}

	<div class="pd-formula-card__body">
		<slot />
	</div>

	{note && (
		<div class="pd-formula-card__note">
			<span class="pd-formula-card__note-label">Insight:</span>
			<span class="pd-formula-card__note-text">{note}</span>
		</div>
	)}
</div>

<style>
	.pd-formula-card {
		margin: 2rem 0;
		padding: 1.35rem 1.45rem;
		box-shadow: 0 4px 18px rgb(0 0 0 / 2%);
	}

	.pd-formula-card__header {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin-bottom: 0.85rem;
	}

	.pd-formula-card__badge {
		padding: 0.15rem 0.5rem;
		background: color-mix(in srgb, var(--sl-color-accent) 10%, transparent);
		border-radius: 999px;
	}

	.pd-formula-card__title {
		margin: 0;
		font-family: var(--pd-font-display);
		font-size: 1.15rem;
		font-weight: 600;
		line-height: 1.3;
		letter-spacing: -0.01em;
		color: var(--sl-color-white);
	}

	.pd-formula-card__desc {
		margin: 0 0 0.85rem;
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}

	.pd-formula-card__body :global(.katex-display) {
		margin: 0.5rem 0 0.75rem;
		padding: 0.85rem 1rem;
		background: var(--pd-surface-hover);
		border: 1px solid var(--pd-rule);
		border-radius: var(--pd-radius);
		overflow-x: auto;
	}

	/* Single-line variable description under the formula */
	.pd-formula-card__body :global(p:not(:has(.katex-display))) {
		margin: 0.75rem 0 0.15rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--pd-rule);
		font-size: 0.92rem;
		line-height: 1.6;
		color: var(--sl-color-gray-2);
	}

	.pd-formula-card__note {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		margin-top: 0.85rem;
		padding-top: 0.75rem;
		border-top: 1px dashed var(--pd-rule-strong);
		font-size: 0.88rem;
		line-height: 1.55;
	}

	.pd-formula-card__note-label {
		flex-shrink: 0;
		font-size: 0.76rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--sl-color-accent);
	}

	.pd-formula-card__note-text {
		color: var(--sl-color-gray-2);
		font-style: italic;
	}
</style>
